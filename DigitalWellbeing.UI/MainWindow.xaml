<Window x:Class="DigitalWellbeing.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DigitalWellbeing.Views"
        mc:Ignorable="d"
        Title="Digital Wellbeing"
        Height="600"
        Width="600">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="28*"/>
            <ColumnDefinition Width="113*"/>
            <ColumnDefinition Width="309*"/>
        </Grid.ColumnDefinitions>
        <views:DashboardView Margin="-1,0,1,0" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="6" >
            <views:DashboardView.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-0.002"/>
                    <TranslateTransform/>
                </TransformGroup>
            </views:DashboardView.RenderTransform>
        </views:DashboardView>
    </Grid>
</Window>
